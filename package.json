{
  "name": "mikebeach-ssh-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Engineering portfolio/CV viewable by running `ssh mikebeach.co.uk`",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",

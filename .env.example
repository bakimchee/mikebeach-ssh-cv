# PEM-encoded RSA/ed25519 private key used as the SSH host key.
# Generate with: ssh-keygen -t ed25519 -f host_key -N "" -C "mikbeach"
# Leave unset for local dev — an ephemeral key is generated in memory on boot
# (fine locally; set a real persisted key in production so the host key
# fingerprint stays stable across deploys).
SSH_HOST_KEY=

# Port the SSH server listens on inside the container.
# Fly maps the public :22 to this port — see fly.toml.
PORT=2222

# Resend (https://resend.com) API key used to deliver messages submitted
# through the in-TUI contact form.
RESEND_API_KEY=

# Where contact-form messages are sent.
CONTACT_TO_EMAIL=
# Sender address Resend sends "from" (must be a verified domain/sender in Resend).
CONTACT_FROM_EMAIL=
